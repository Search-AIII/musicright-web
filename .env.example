# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: app.supabase.com → your project → Settings → API

# Public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose this in the browser, server/API routes only
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Anthropic (optional — for AI-powered parsing) ─────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (optional — for lead notifications) ─────────────────────────────────
# Get from: resend.com → API Keys
# If not set, the /api/waitlist route skips email and only saves to DB
RESEND_API_KEY=re_...

# Email address to receive new lead notifications
OWNER_EMAIL=contact@musicright.ai

# ── Fish Audio (AI Vocals) ────────────────────────────────────────────────────
# Get from: fish.audio → Account → API Keys
# Used by /api/vocals → calls Fish Audio TTS for lyric-to-voice generation
FISH_AUDIO_API_KEY=fal_...

# ── Replicate (AI Instrumental Generation) ────────────────────────────────────
# Get from: replicate.com → Account Settings → API Tokens
# Used by /api/generate → calls Meta MusicGen model
REPLICATE_API_TOKEN=r8_...

# ── App URL (set to your production URL on Vercel) ────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.musicright.ai
